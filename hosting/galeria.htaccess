# galeria/.htaccess — la galería pública de ScopePower son solo ficheros estáticos.
# Lo sube la propia app (publicar.py) a la raíz de galeria/ con cada sincronización.
# Solo directivas que entienden Apache y LiteSpeed (sin <If>: LiteSpeed no lo admite).

DirectoryIndex index.html
# Sin listados de carpetas
IndexIgnore *

# Nada de lo que hay aquí se ejecuta: lo sube la app, no es código
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .php5 .php7 .phps .pl .cgi .py .sh
RemoveType .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php5|php7|phps|pl|cgi|py|sh)$">
    Require all denied
</FilesMatch>

AddType application/json .json
AddType image/webp .webp
AddType text/javascript .js
AddCharset UTF-8 .html .js .css .json .md .txt

# Caché: el índice y las páginas, unos minutos (cambian al publicar); las fotos llevan ?v= y lo
# común va en una carpeta por versión, así que pueden guardarse mucho tiempo
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 5 minutes"
    ExpiresByType text/html "access plus 5 minutes"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
</IfModule>
