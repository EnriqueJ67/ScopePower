#: static/js/asistente.js
msgid "<b>ASTAP está instalado pero sin catálogo de estrellas</b> ({ruta})."
msgstr "<b>ASTAP is installed but without a star catalog</b> ({ruta})."

#: static/js/asistente.js
msgid "<b>ASTAP está instalado</b> con el catálogo {catalogos}."
msgstr "<b>ASTAP is installed</b> with catalog {catalogos}."

#: static/js/asistente.js
msgid "<b>ASTAP no está instalado en este PC.</b>"
msgstr "<b>ASTAP isn't installed on this PC.</b>"

#: templates/_asistente.html
msgid "<b>ASTAP</b>: el programa que reconoce las estrellas de cada foto. Si falta, se instala solo."
msgstr "<b>ASTAP</b>: the program that recognizes the stars in each shot. If it's missing, it installs itself."

#: templates/_asistente.html
msgid "<b>Captura</b>: exposición y ganancia de partida."
msgstr "<b>Capture</b>: starting exposure and gain."

#: static/js/asistente.js
msgid "<b>Celestron</b>: mando NexStar o StarSense por cable al PC (o CPWI abierto, según el driver). El puerto COM se elige con «Configurar el driver en el PC»."
msgstr "<b>Celestron</b>: NexStar or StarSense hand controller by cable to the PC (or CPWI open, depending on the driver). The COM port is chosen with “Set up the driver on the PC”."

#: static/js/asistente.js
msgid "<b>EQMOD</b>: montura Sky-Watcher u Orion por cable EQDirect al PC. Al conectar se abre su ventana en el PC; el puerto COM se elige ahí o con «Configurar el driver en el PC»."
msgstr "<b>EQMOD</b>: Sky-Watcher or Orion mount with an EQDirect cable to the PC. When connecting, its window opens on the PC; the COM port is chosen there or with “Set up the driver on the PC”."

#: static/js/asistente.js
msgid "<b>Esp32Go</b>: por wifi. La dirección IP se pone con «Configurar el driver en el PC»."
msgstr "<b>Esp32Go</b>: over Wi-Fi. The IP address is set with “Set up the driver on the PC”."

#: templates/imagen.html
msgid "<b>Filtro solar obligatorio</b>, delante del objetivo y bien sujeto, y tapa el buscador. Sin filtro, el Sol destroza el sensor en segundos y ciega a quien mire por el telescopio. La app no puede comprobar que el filtro está puesto."
msgstr "<b>Solar filter required</b>, in front of the lens and firmly attached, and cover the finder. Without a filter, the Sun destroys the sensor in seconds and blinds anyone looking through the telescope. The app can't check that the filter is in place."

#: static/js/asistente.js
msgid "<b>GSServer</b>: ábrelo en el PC y conéctalo a la montura antes de probar."
msgstr "<b>GSServer</b>: open it on the PC and connect it to the mount before testing."

#: templates/configuracion.html
msgid "<b>Incremental:</b> las primeras fotos buenas (10) fijan la referencia y las siguientes se suman quitando lo que no encaja con ella (satélites, aviones). Tiempo fijo por foto y sin máximo, pero una foto que ha entrado ya no se puede quitar."
msgstr "<b>Incremental:</b> the first good frames (10) set the reference and the following ones are added, removing whatever doesn't match it (satellites, planes). Fixed time per frame and no maximum, but a frame that's in can't be taken out."

#: templates/configuracion.html
msgid "<b>Las N mejores:</b> se guardan las mejores fotos hasta el máximo y se reapilan todas con cada foto nueva; una foto mejor sustituye a la peor. El tiempo por foto crece con el número de fotos."
msgstr "<b>Best N frames:</b> the best frames are kept up to the maximum and all of them are restacked with each new frame; a better frame replaces the worst one. Time per frame grows with the number of frames."

#: static/js/asistente.js
msgid "<b>Meade / LX200</b>: cable al PC. El puerto COM se elige con «Configurar el driver en el PC»."
msgstr "<b>Meade / LX200</b>: cable to the PC. The COM port is chosen with “Set up the driver on the PC”."

#: templates/_asistente.html
msgid "<b>Montura y cámara</b>: elegimos sus drivers y probamos que conectan de verdad."
msgstr "<b>Mount and camera</b>: we pick their drivers and test that they really connect."

#: static/js/asistente.js
msgid "<b>No conecta:</b> {error}"
msgstr "<b>Can't connect:</b> {error}"

#: static/js/asistente.js
msgid "<b>OnStep</b>: por USB o por wifi. El puerto o la dirección IP se ponen con «Configurar el driver en el PC»."
msgstr "<b>OnStep</b>: over USB or Wi-Fi. The port or IP address is set with “Set up the driver on the PC”."

#: templates/_asistente.html
msgid "<b>ScopePower está listo.</b> Puedes cambiar cualquiera de estos datos en Configuración o volver a pasar el asistente desde allí."
msgstr "<b>ScopePower is ready.</b> You can change any of these settings in Settings or run the wizard again from there."

#. js
#: templates/configuracion.html
msgid "<b>ScopePower se está actualizando.</b> La página se recargará sola cuando vuelva (puede tardar unos minutos)..."
msgstr "<b>ScopePower is updating.</b> The page will reload by itself when it's back (it may take a few minutes)..."

#. js
#: templates/apagar.html
msgid "<b>ScopePower se está reiniciando.</b> Esta página volverá sola a Inicio cuando responda..."
msgstr "<b>ScopePower is restarting.</b> This page will go back to Home by itself when it responds..."

